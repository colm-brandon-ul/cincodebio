# cinco-glsp
WORKSPACE_PATH=/workspace
TRANSPILATION_MODE="WATCH"
EDITOR_TYPE=LANGUAGE_EDITOR
ENVIRONMENT="" \
# theia variables
THEIA_WEBVIEW_ENDPOINT_PATTERN={{hostname}}
THEIA_MINI_BROWSER_HOST_PATTERN={{hostname}}
USE_SSL=false
CINCO_ALLOWED_ORIGINS=["localhost", "0.0.0.0", "cdb.local", "minio.cdb.local", "*.webview.cdb.local", "http://cdb.local", "http://minio.cdb.local"]
CINCODEBIO_API_BASE_URL=http://host.docker.internal
# Optional service-specific overrides used by in-cluster deployments.
# CINCODEBIO_SIB_MANAGER_BASE_URL=http://sib-manager
# CINCODEBIO_EXECUTION_API_BASE_URL=http://execution-api
