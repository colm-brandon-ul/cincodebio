        { "id": "example_service_label", "type": "siblibrary:label", "_attributes": { "name": "SegmentCells", "label": "Segment Cells", "icon": "icons/service.png" }, "_position": { "x": 0, "y": 45 }, "_size": { "width": 300, "height": 50 } },
        { "id": "example_service_output", "type": "siblibrary:output", "_attributes": { "name": "cell_masks", "typeName": "CellMask", "list": "true" }, "_position": { "x": 0, "y": 100 }, "_size": { "width": 300, "height": 20 } },
        { "id": "example_service_success", "type": "siblibrary:branch", "_attributes": { "name": "success" }, "_position": { "x": 0, "y": 125 }, "_size": { "width": 300, "height": 20 } }
