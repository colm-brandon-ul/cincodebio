      "_position": { "x": 80, "y": 500 },
      "_size": { "width": 300, "height": 170 },
      "_containments": [
        { "id": "example_task_label", "type": "siblibrary:label", "_attributes": { "name": "CollectSlideMetadata", "label": "Collect Slide Metadata", "icon": "icons/task.png" }, "_position": { "x": 0, "y": 20 }, "_size": { "width": 300, "height": 50 } },
        { "id": "example_task_output", "type": "siblibrary:output", "_attributes": { "name": "slide_metadata", "typeName": "SlideMetadata", "list": "false" }, "_position": { "x": 0, "y": 75 }, "_size": { "width": 300, "height": 20 } },
        { "id": "example_task_success", "type": "siblibrary:branch", "_attributes": { "name": "success" }, "_position": { "x": 0, "y": 100 }, "_size": { "width": 300, "height": 20 } }
      ]
    },
    {
      "id": "example-service-segment-cells",
      "type": "siblibrary:service",
      "_attributes": {
        "name": "SegmentCells",
        "label": "Segment Cells",
